<%- include('partials/header', { title: 'About' }) %>

<section class="section">
  <h1><span class="sec-tag">&gt;_</span> WHO_AM_I</h1>
  <div class="terminal">
    <div class="term-bar">
      <span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>
      <span class="term-title">sudhanshu@kali: ~/about</span>
    </div>
    <div class="term-body">
      <p class="term-line"><span class="p">➜</span> <span class="cmd">cat about.txt</span></p>
      <p style="white-space: pre-line;"><%= settings.aboutText %></p>
      <p class="term-line"><span class="p">➜</span> <span class="cmd">ls contact_info/</span></p>
      <ul class="info-list">
        <% if (settings.email) { %><li>&gt; 📧 <%= settings.email %></li><% } %>
        <% if (settings.phone) { %><li>&gt; 📱 <%= settings.phone %></li><% } %>
        <% if (settings.location) { %><li>&gt; 📍 <%= settings.location %></li><% } %>
      </ul>
      <div class="btn-row">
        <a class="btn" href="/contact">[ CONTACT ME ]</a>
        <% if (settings.github) { %><a class="btn ghost" href="<%= settings.github %>" target="_blank">[ GITHUB ]</a><% } %>
        <% if (settings.linkedin) { %><a class="btn ghost" href="<%= settings.linkedin %>" target="_blank">[ LINKEDIN ]</a><% } %>
        <% if (settings.twitter) { %><a class="btn ghost" href="<%= settings.twitter %>" target="_blank">[ TWITTER/X ]</a><% } %>
        <% if (settings.telegram) { %><a class="btn ghost" href="https://t.me/<%= settings.telegram.replace(/@/, '') %>" target="_blank">[ TELEGRAM ]</a><% } %>
        <% (settings.customLinks || []).forEach(l => { %><a class="btn ghost" href="<%= l.url %>" target="_blank">[ <%= l.label.toUpperCase() %> ]</a><% }) %>
      </div>
    </div>
  </div>
</section>

<% if (typeof experience !== 'undefined' && experience.length) { %>
<section class="section">
  <h2><span class="sec-tag">&gt;_</span> WORK_HISTORY <span class="muted" style="font-size:0.9rem">[ experience ]</span></h2>
  <div class="timeline">
    <% experience.forEach(e => { %>
      <div class="timeline-item">
        <div class="tl-dot <%= e.current ? 'live' : '' %>"></div>
        <div class="tl-card">
          <div class="row-between">
            <h3><%= e.role %> <span class="p">@</span> <span class="ok"><%= e.company %></span></h3>
            <% if (e.current) { %><span class="tl-badge">● CURRENT</span><% } %>
          </div>
          <% if (e.duration) { %><p class="mono muted tl-duration"><%= e.duration %></p><% } %>
          <% if (e.description) { %><p class="muted" style="white-space: pre-line;"><%= e.description %></p><% } %>
        </div>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

<% if (typeof gh !== 'undefined' && gh.ok) { %>
<section class="section">
  <h1><span class="sec-tag">&gt;_</span> GITHUB_INTEL <span class="muted" style="font-size:0.9rem">[ live @ <%= gh.profile.username %> ]</span></h1>
  <div class="gh-profile">
    <img class="gh-avatar" src="<%= gh.profile.avatar %>" alt="<%= gh.profile.name %>">
    <div class="gh-pinfo">
      <h3 class="mono"><%= gh.profile.name %></h3>
      <p class="muted"><%= gh.profile.bio %></p>
      <p class="muted small">member since <%= gh.profile.createdAt %> · <a class="link" href="<%= gh.profile.url %>" target="_blank">github.com/<%= gh.profile.username %> →</a></p>
    </div>
  </div>
  <div class="gh-stats">
    <a class="gh-stat" href="<%= gh.profile.url %>?tab=repositories" target="_blank"><span class="stat-num"><%= gh.profile.publicRepos %></span><span class="stat-label">Public Repos</span></a>
    <div class="gh-stat"><span class="stat-num">⭐ <%= gh.totalStars %></span><span class="stat-label">Total Stars</span></div>
    <div class="gh-stat"><span class="stat-num"><%= gh.profile.followers %></span><span class="stat-label">Followers</span></div>
    <div class="gh-stat"><span class="stat-num"><%= gh.profile.following %></span><span class="stat-label">Following</span></div>
  </div>
  <% if (gh.topLanguages.length) { %>
  <div class="panel">
    <h2>🧰 Most Used Languages</h2>
    <div class="lang-legend">
      <% gh.topLanguages.forEach(l => { %>
        <span class="lang-item"><span class="lang-dot" style="background:<%= l.color %>"></span> <%= l.name %> <small class="muted">×<%= l.count %></small></span>
      <% }) %>
    </div>
  </div>
  <% } %>
</section>
<% } %>

<%- include('partials/footer') %>
