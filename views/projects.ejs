<%- include('partials/header', { title: 'Projects' }) %>

<section class="section">
  <h1><span class="sec-tag">&gt;_</span> OPERATIONS <span class="muted" style="font-size:0.95rem">[ case files ]</span></h1>
  <% if (!projects.length) { %>
    <p class="muted">No operations declassified yet. More coming soon... ⏳</p>
  <% } else { %>
    <div class="card-grid" data-autogrid="4">
      <% projects.forEach(p => { %>
        <a class="card" href="/projects/<%= p._id %>">
          <% if (p.image) { %><img class="card-img" src="<%= p.image %>" alt="<%= p.title %>"><% } %>
          <div class="card-body">
            <h3>[ <%= p.title %> ]</h3>
            <p class="muted clamp2"><%= p.description %></p>
            <div class="chips">
              <% p.techStack.split(',').map(t => t.trim()).filter(Boolean).forEach(t => { %>
                <span class="chip"><%= t %></span>
              <% }) %>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
