<%- include('partials/header', { title: 'Contact' }) %>

<section class="section narrow">
  <h1>Contact Me</h1>
  <p class="muted">Fill the form below — your message will reach me directly.</p>

  <% if (query.sent) { %>
    <div class="alert success">✅ Message sent! I will get back to you soon.</div>
  <% } %>
  <% if (query.error) { %>
    <div class="alert error">❌ Please fill all fields with a valid email.</div>
  <% } %>

  <form method="POST" action="/contact" class="form">
    <label>Name
      <input type="text" name="name" required>
    </label>
    <label>Email
      <input type="email" name="email" required>
    </label>
    <label>Message
      <textarea name="message" rows="5" required></textarea>
    </label>
    <button type="submit" class="btn">Send Message</button>
  </form>

  <div class="btn-row" style="margin-top: 1.5rem;">
    <% if (settings.email) { %><p>📧 <%= settings.email %></p><% } %>
    <% if (settings.phone) { %><p>📱 <%= settings.phone %></p><% } %>
  </div>
</section>

<%- include('partials/footer') %>
