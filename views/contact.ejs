<%- include('partials/header', { title: 'Contact' }) %>

<section class="section narrow">
  <h1><span class="sec-tag">&gt;_</span> SECURE_CONTACT</h1>
  <p class="muted">Fill the form below — your message goes straight to my admin panel. 🔒</p>

  <div class="terminal small">
    <div class="term-bar">
      <span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>
      <span class="term-title">secure_channel.sh</span>
    </div>
    <div class="term-body">
      <p class="term-line"><span class="p">➜</span> <span class="cmd">./send_message --encrypted</span></p>

      <% if (query.sent) { %>
        <div class="alert success">&gt;&gt; TRANSMISSION COMPLETE. You will get a reply soon.</div>
      <% } %>
      <% if (query.error === 'rate') { %>
        <div class="alert error">&gt;&gt; You already sent a message — try again after 2 minutes.</div>
      <% } else if (query.error) { %>
        <div class="alert error">&gt;&gt; ERROR: fill all fields with a valid email.</div>
      <% } %>

      <form method="POST" action="/contact" class="form">
        <label>Name
          <input type="text" name="name" maxlength="60" required>
        </label>
        <label>Email
          <input type="email" name="email" maxlength="100" required>
        </label>
        <label>Message
          <textarea name="message" rows="5" maxlength="2000" required></textarea>
        </label>
        <button type="submit" class="btn">[ TRANSMIT → ]</button>
      </form>
    </div>
  </div>

  <h2 style="margin-top: 1.5rem;">Direct Channels</h2>
  <div class="btn-row">
    <% if (settings.linkedin) { %><a class="btn ghost" href="<%= settings.linkedin %>" target="_blank" rel="noopener">[ LINKEDIN ]</a><% } %>
    <% if (settings.whatsapp) { %><a class="btn ghost" href="https://wa.me/<%= settings.whatsapp.replace(/\D/g, '') %>" target="_blank">[ WHATSAPP ]</a><% } %>
    <% if (settings.telegram) { %><a class="btn ghost" href="https://t.me/<%= settings.telegram.replace(/@/, '') %>" target="_blank">[ TELEGRAM ]</a><% } %>
    <% if (settings.email) { %><a class="btn ghost" href="mailto:<%= settings.email %>">[ EMAIL ]</a><% } %>
    <% (settings.customLinks || []).forEach(l => { %><a class="btn ghost" href="<%= l.url %>" target="_blank">[ <%= l.label.toUpperCase() %> ]</a><% }) %>
  </div>
</section>

<%- include('partials/footer') %>
