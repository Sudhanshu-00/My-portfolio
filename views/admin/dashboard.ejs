<%- include('../partials/admin_head', { title: 'Dashboard' }) %>

<h1>📊 Dashboard</h1>
<p class="muted">Welcome back, <strong><%= admin %></strong> — system status: <span class="ok">ALL GREEN</span></p>

<div class="stat-grid">
  <div class="stat-card">
    <span class="stat-num"><%= stats.viewsToday %></span>
    <span class="stat-label">Views Today</span>
  </div>
  <div class="stat-card">
    <span class="stat-num"><%= stats.totalViews %></span>
    <span class="stat-label">Total Page Views</span>
  </div>
  <a class="stat-card" href="<%= adminBase %>/tools">
    <span class="stat-num"><%= counts.tools %></span>
    <span class="stat-label">Tools (For Sale)</span>
  </a>
  <a class="stat-card" href="<%= adminBase %>/projects">
    <span class="stat-num"><%= counts.projects %></span>
    <span class="stat-label">Projects</span>
  </a>
  <a class="stat-card" href="<%= adminBase %>/skills">
    <span class="stat-num"><%= counts.skills %></span>
    <span class="stat-label">Skills</span>
  </a>
  <a class="stat-card" href="<%= adminBase %>/services">
    <span class="stat-num"><%= counts.services %></span>
    <span class="stat-label">Services (Hire Me)</span>
  </a>
  <a class="stat-card" href="<%= adminBase %>/testimonials">
    <span class="stat-num"><%= counts.testimonials %></span>
    <span class="stat-label">Testimonials</span>
  </a>
  <a class="stat-card" href="<%= adminBase %>/labs">
    <span class="stat-num"><%= counts.labs %></span>
    <span class="stat-label">Labs Solved</span>
  </a>
  <a class="stat-card" href="<%= adminBase %>/security">
    <span class="stat-num"><%= counts.threatsToday %></span>
    <span class="stat-label">Threats Today</span>
  </a>
  <a class="stat-card" href="<%= adminBase %>/security#blocked">
    <span class="stat-num"><%= counts.blockedNow %></span>
    <span class="stat-label">Blocked IPs</span>
  </a>
  <a class="stat-card" href="<%= adminBase %>/users">
    <span class="stat-num"><%= counts.userCount %></span>
    <span class="stat-label">User Accounts</span>
  </a>
  <a class="stat-card" href="<%= adminBase %>/messages">
    <span class="stat-num"><%= counts.unread %></span>
    <span class="stat-label">Unread Messages</span>
  </a>
</div>

<div class="panel">
  <div class="row-between">
    <h2>📈 Traffic — <%= range === '1y' ? 'Last 12 Months' : 'Last ' + (range === '7d' ? '7' : '30') + ' Days' %></h2>
    <div class="range-tabs">
      <a class="btn small <%= range === '7d' ? '' : 'ghost' %>" href="<%= adminBase %>?range=7d">7D</a>
      <a class="btn small <%= range === '30d' ? '' : 'ghost' %>" href="<%= adminBase %>?range=30d">30D</a>
      <a class="btn small <%= range === '1y' ? '' : 'ghost' %>" href="<%= adminBase %>?range=1y">1 YEAR</a>
    </div>
  </div>
  <p class="muted" style="margin-bottom:0.5rem">👁 <%= stats.rangeViews %> views in this range</p>
  <div class="chart <%= range === '30d' ? 'chart-wide' : '' %>">
    <% chart.forEach(c => { %>
      <div class="chart-col">
        <span class="chart-num"><%= c.count %></span>
        <div class="chart-bar" style="height: <%= Math.round((c.count / maxCount) * 100) %>%"></div>
        <small><%= c.label %></small>
      </div>
    <% }) %>
  </div>
</div>

<div class="two-col">
  <div class="panel">
    <h2>🔥 Top Pages</h2>
    <% if (!topPages.length) { %><p class="muted">No traffic data yet.</p><% } %>
    <table class="table tight">
      <% topPages.forEach(p => { %>
        <tr>
          <td class="mono"><%= p._id %></td>
          <td style="text-align:right"><span class="ok"><%= p.count %></span> views</td>
        </tr>
      <% }) %>
    </table>
  </div>

  <div class="panel">
    <h2>📩 Recent Messages</h2>
    <% if (!recent.length) { %><p class="muted">No messages yet.</p><% } %>
    <% recent.forEach(m => { %>
      <div class="mini-msg <%= m.read ? '' : 'unread' %>">
        <strong><%= m.name %></strong>
        <span class="muted">— <%= m.message.slice(0, 60) %><%= m.message.length > 60 ? '…' : '' %></span>
      </div>
    <% }) %>
    <a class="link" href="<%= adminBase %>/messages">all messages →</a>
  </div>
</div>

<div class="section">
  <h2>⚡ Quick Actions — every page is edited from here</h2>
  <div class="qa-grid">
    <a class="qa-card" href="<%= adminBase %>/settings"><span>🏠</span><strong>Home / Hero</strong><small>title, subtitle, photo</small></a>
    <a class="qa-card" href="<%= adminBase %>/settings"><span>👤</span><strong>About Page</strong><small>text, contact info</small></a>
    <a class="qa-card" href="<%= adminBase %>/settings"><span>🔗</span><strong>Social Links</strong><small>github, linkedin, custom</small></a>
    <a class="qa-card" href="<%= adminBase %>/tools/new"><span>🛠️</span><strong>Add Tool</strong><small>tools for sale</small></a>
    <a class="qa-card" href="<%= adminBase %>/projects/new"><span>📂</span><strong>Add Project</strong><small>case file</small></a>
    <a class="qa-card" href="<%= adminBase %>/skills"><span>⚡</span><strong>Manage Skills</strong><small>add / delete</small></a>
    <a class="qa-card" href="<%= adminBase %>/services"><span>💼</span><strong>Services</strong><small>hire me / pricing</small></a>
    <a class="qa-card" href="<%= adminBase %>/testimonials"><span>🗣</span><strong>Testimonials</strong><small>client feedback</small></a>
    <a class="qa-card" href="<%= adminBase %>/experience"><span>🏢</span><strong>Work Experience</strong><small>company / role</small></a>
    <a class="qa-card" href="<%= adminBase %>/labs"><span>🎯</span><strong>Labs</strong><small>THM / PortSwigger</small></a>
    <a class="qa-card" href="<%= adminBase %>/feedback"><span>💬</span><strong>Feedback</strong><small>moderate + reply</small></a>
    <a class="qa-card" href="<%= adminBase %>/settings#resume"><span>📄</span><strong>Upload Resume</strong><small>CV / PDF</small></a>
    <a class="qa-card" href="<%= adminBase %>/messages"><span>📩</span><strong>Messages</strong><small>inbox</small></a>
    <a class="qa-card" href="<%= adminBase %>/password"><span>🔑</span><strong>Password</strong><small>security</small></a>
  </div>
</div>

<%- include('../partials/admin_foot') %>
