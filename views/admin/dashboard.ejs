<%- include('../partials/admin_head', { title: 'Dashboard' }) %>

<h1>📊 Dashboard</h1>
<p class="muted">Welcome back, <strong><%= admin %></strong> — system status: <span class="ok">ALL GREEN</span></p>

<div class="stat-grid">
  <div class="stat-card">
    <span class="stat-num"><%= stats.viewsToday %></span>
    <span class="stat-label">Views Today</span>
  </div>
  <div class="stat-card">
    <span class="stat-num"><%= stats.totalViews %></span>
    <span class="stat-label">Total Page Views</span>
  </div>
  <a class="stat-card" href="/admin/tools">
    <span class="stat-num"><%= counts.tools %></span>
    <span class="stat-label">Tools (For Sale)</span>
  </a>
  <a class="stat-card" href="/admin/projects">
    <span class="stat-num"><%= counts.projects %></span>
    <span class="stat-label">Projects</span>
  </a>
  <a class="stat-card" href="/admin/skills">
    <span class="stat-num"><%= counts.skills %></span>
    <span class="stat-label">Skills</span>
  </a>
  <a class="stat-card" href="/admin/services">
    <span class="stat-num"><%= counts.services %></span>
    <span class="stat-label">Services (Hire Me)</span>
  </a>
  <a class="stat-card" href="/admin/testimonials">
    <span class="stat-num"><%= counts.testimonials %></span>
    <span class="stat-label">Testimonials</span>
  </a>
  <a class="stat-card" href="/admin/messages">
    <span class="stat-num"><%= counts.unread %></span>
    <span class="stat-label">Unread Messages</span>
  </a>
</div>

<div class="panel">
  <h2>📈 Traffic — Last 7 Days</h2>
  <div class="chart">
    <% chart.forEach(c => { %>
      <div class="chart-col">
        <span class="chart-num"><%= c.count %></span>
        <div class="chart-bar" style="height: <%= Math.round((c.count / maxCount) * 100) %>%"></div>
        <small><%= c.label %></small>
      </div>
    <% }) %>
  </div>
</div>

<div class="two-col">
  <div class="panel">
    <h2>🔥 Top Pages</h2>
    <% if (!topPages.length) { %><p class="muted">No traffic data yet.</p><% } %>
    <table class="table tight">
      <% topPages.forEach(p => { %>
        <tr>
          <td class="mono"><%= p._id %></td>
          <td style="text-align:right"><span class="ok"><%= p.count %></span> views</td>
        </tr>
      <% }) %>
    </table>
  </div>

  <div class="panel">
    <h2>📩 Recent Messages</h2>
    <% if (!recent.length) { %><p class="muted">No messages yet.</p><% } %>
    <% recent.forEach(m => { %>
      <div class="mini-msg <%= m.read ? '' : 'unread' %>">
        <strong><%= m.name %></strong>
        <span class="muted">— <%= m.message.slice(0, 60) %><%= m.message.length > 60 ? '…' : '' %></span>
      </div>
    <% }) %>
    <a class="link" href="/admin/messages">all messages →</a>
  </div>
</div>

<div class="section">
  <h2>⚡ Quick Actions — har page yahan se edit hota hai</h2>
  <div class="qa-grid">
    <a class="qa-card" href="/admin/settings"><span>🏠</span><strong>Home / Hero</strong><small>title, subtitle, photo</small></a>
    <a class="qa-card" href="/admin/settings"><span>👤</span><strong>About Page</strong><small>text, contact info</small></a>
    <a class="qa-card" href="/admin/settings"><span>🔗</span><strong>Social Links</strong><small>github, linkedin, custom</small></a>
    <a class="qa-card" href="/admin/tools/new"><span>🛠️</span><strong>Add Tool</strong><small>bechne ke liye</small></a>
    <a class="qa-card" href="/admin/projects/new"><span>📂</span><strong>Add Project</strong><small>case file</small></a>
    <a class="qa-card" href="/admin/skills"><span>⚡</span><strong>Manage Skills</strong><small>add / delete</small></a>
    <a class="qa-card" href="/admin/services"><span>💼</span><strong>Services</strong><small>hire me / pricing</small></a>
    <a class="qa-card" href="/admin/testimonials"><span>🗣</span><strong>Testimonials</strong><small>client feedback</small></a>
    <a class="qa-card" href="/admin/settings#resume"><span>📄</span><strong>Upload Resume</strong><small>CV / PDF</small></a>
    <a class="qa-card" href="/admin/messages"><span>📩</span><strong>Messages</strong><small>inbox</small></a>
    <a class="qa-card" href="/admin/password"><span>🔑</span><strong>Password</strong><small>security</small></a>
  </div>
</div>

<%- include('../partials/admin_foot') %>
