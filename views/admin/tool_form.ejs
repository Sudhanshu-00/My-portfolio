<%- include('../partials/admin_head') %>

<h1><%= tool ? '✏️ Edit Tool' : '＋ Add Tool' %></h1>

<form method="POST" enctype="multipart/form-data" class="form"
      action="<%= tool ? '/admin/tools/' + tool._id : '/admin/tools' %>">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Tool Name
    <input type="text" name="name" required value="<%= tool ? tool.name : '' %>">
  </label>
  <label>Category
    <select name="category">
      <% ['Android', 'Web', 'Network', 'Other'].forEach(c => { %>
        <option value="<%= c %>" <%= tool && tool.category === c ? 'selected' : '' %>><%= c %></option>
      <% }) %>
    </select>
  </label>
  <label>Price (e.g. ₹1,999 ya $29)
    <input type="text" name="price" value="<%= tool ? tool.price : '' %>">
  </label>
  <label>Description (tool kya karta hai, features etc.)
    <textarea name="description" rows="5"><%= tool ? tool.description : '' %></textarea>
  </label>
  <label>Demo / Video URL (optional)
    <input type="text" name="demoUrl" value="<%= tool ? tool.demoUrl : '' %>" placeholder="https://youtube.com/...">
  </label>
  <label>Buy URL (optional — khali chhoda to WhatsApp link automatic ban jayega)
    <input type="text" name="buyUrl" value="<%= tool ? tool.buyUrl : '' %>" placeholder="https://razorpay.me/... ya khali chhodo">
  </label>
  <label>Screenshot / Photo
    <input type="file" name="image" accept="image/*">
  </label>
  <% if (tool && tool.image) { %>
    <img src="<%= tool.image %>" class="thumb big" alt="">
    <small class="muted">(Naya upload karne par change hogi)</small>
  <% } %>
  <label class="check">
    <input type="checkbox" name="featured" <%= tool && tool.featured ? 'checked' : '' %>>
    ⭐ Featured (home page par dikhega)
  </label>
  <div class="btn-row">
    <button type="submit" class="btn"><%= tool ? '💾 Update Tool' : '＋ Create Tool' %></button>
    <a class="btn ghost" href="<%= adminBase %>/tools">Cancel</a>
  </div>
</form>

<%- include('../partials/admin_foot') %>
