<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Account Recovery</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .pw-toggle { background:transparent; border:1px solid rgba(255,255,255,0.2); border-radius:6px; color:inherit; font-size:0.72rem; padding:0.4rem 0.6rem; cursor:pointer; white-space:nowrap; }
    .pw-toggle:hover { border-color:rgba(126,231,135,0.5); }
  </style>
</head>
<body class="login-page">
  <div class="login-box">
    <h1>&gt;_ RECOVERY</h1>

    <% if (step === 'request') { %>
      <p class="muted">Enter your username and registered email — an OTP will be sent to the email.</p>
      <% if (error) { %><div class="alert error"><%= error %></div><% } %>
      <form method="POST" action="/forgot" class="form">
        <label>Username
          <input type="text" name="username" required autofocus autocomplete="off">
        </label>
        <label>Registered Email
          <input type="email" name="email" required autocomplete="off">
        </label>
        <button type="submit" class="btn full">Send OTP</button>
      </form>

    <% } else if (step === 'otp') { %>
      <% if (info) { %><div class="alert success"><%= info %></div><% } %>
      <% if (error) { %><div class="alert error"><%= error %></div><% } %>
      <form method="POST" action="/forgot/verify" class="form">
        <input type="hidden" name="username" value="<%= username %>">
        <label>6-digit OTP (check your email)
          <input type="text" name="otp" required autofocus inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="••••••" autocomplete="one-time-code">
        </label>
        <button type="submit" class="btn full">Verify OTP</button>
      </form>

    <% } else if (step === 'reset') { %>
      <p class="muted">Set a new password — <strong>min 8 characters</strong> with UPPERCASE + lowercase + number + symbol. Dono match na hue to error dikhega.</p>
      <% if (error) { %><div class="alert error"><%= error %></div><% } %>
      <form method="POST" action="/reset" class="form">
        <label>New Password
          <input type="password" name="password" id="rsPass" required autofocus minlength="8">
        </label>
        <label>Confirm Password
          <input type="password" name="confirm" id="rsConfirm" required minlength="8">
        </label>
        <div class="actions" style="gap:0.5rem">
          <button type="button" class="btn small outline" data-reveal="rsPass">👁 show</button>
          <button type="button" class="btn small outline" data-reveal="rsConfirm">👁 show confirm</button>
          <button type="submit" class="btn full">Reset Password</button>
        </div>
      </form>
    <% } %>

    <a href="/login" class="link">← Back to login</a>
  </div>
  <script src="/js/showpass.js" defer></script>
</body>
</html>
