<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Account Recovery</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-page">
  <div class="login-box">
    <h1>&gt;_ RECOVERY</h1>

    <% if (step === 'request') { %>
      <p class="muted">Enter your username and registered email — an OTP will be sent to the email.</p>
      <% if (error) { %><div class="alert error"><%= error %></div><% } %>
      <form method="POST" action="/forgot" class="form">
        <label>Username
          <input type="text" name="username" required autofocus autocomplete="off">
        </label>
        <label>Registered Email
          <input type="email" name="email" required autocomplete="off">
        </label>
        <button type="submit" class="btn full">Send OTP</button>
      </form>

    <% } else if (step === 'otp') { %>
      <% if (info) { %><div class="alert success"><%= info %></div><% } %>
      <% if (error) { %><div class="alert error"><%= error %></div><% } %>
      <form method="POST" action="/forgot/verify" class="form">
        <input type="hidden" name="username" value="<%= username %>">
        <label>6-digit OTP (check your email)
          <input type="text" name="otp" required autofocus inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="••••••" autocomplete="one-time-code">
        </label>
        <button type="submit" class="btn full">Verify OTP</button>
      </form>

    <% } else if (step === 'reset') { %>
      <p class="muted">Set a new password — minimum 10 characters with a letter and a number.</p>
      <% if (error) { %><div class="alert error"><%= error %></div><% } %>
      <form method="POST" action="/reset" class="form">
        <label>New Password
          <input type="password" name="password" required autofocus minlength="10">
        </label>
        <label>Confirm Password
          <input type="password" name="confirm" required minlength="10">
        </label>
        <button type="submit" class="btn full">Reset Password</button>
      </form>
    <% } %>

    <a href="/login" class="link">← Back to login</a>
  </div>
</body>
</html>
