<%- include('../partials/admin_head') %>

<h1>🗣 Testimonials</h1>
<p class="muted">Clients ka feedback — Home page ke <strong>CLIENT_FEEDBACK</strong> section me ⭐ ratings ke saath dikhenge.</p>

<div class="panel">
  <h2><%= editTestimonial ? '✏️ Edit Testimonial: ' + editTestimonial.name : '➕ Add New Testimonial' %></h2>
  <form method="POST" action="<%= editTestimonial ? '/admin/testimonials/' + editTestimonial._id + '/update' : '/admin/testimonials' %>" class="form"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="row-form">
      <label>Client Name
        <input type="text" name="name" placeholder="e.g. Rahul Sharma" required value="<%= editTestimonial ? editTestimonial.name : '' %>">
      </label>
      <label>Company (optional)
        <input type="text" name="company" placeholder="e.g. ShopKart India" value="<%= editTestimonial ? editTestimonial.company : '' %>">
      </label>
      <label>Rating
        <select name="rating">
          <% [5,4,3,2,1].forEach(r => { %>
            <option value="<%= r %>" <%= (editTestimonial ? editTestimonial.rating : 5) === r ? 'selected' : '' %>><%= '⭐'.repeat(r) %> (<%= r %>)</option>
          <% }) %>
        </select>
      </label>
    </div>
    <label>Feedback
      <textarea name="text" rows="3" placeholder="What did the client say?" required><%= editTestimonial ? editTestimonial.text : '' %></textarea>
    </label>
    <button type="submit" class="btn"><%= editTestimonial ? '💾 Update Testimonial' : '➕ Add Testimonial' %></button>
    <% if (editTestimonial) { %><a class="btn ghost" href="<%= adminBase %>/testimonials">Cancel</a><% } %>
  </form>
</div>

<h2>Current Testimonials (<%= testimonials.length %>)</h2>
<% if (!testimonials.length) { %><p class="muted">No testimonials yet — upar se add karo.</p><% } %>
<table class="table">
  <tr><th>Client</th><th>Rating</th><th>Feedback</th><th style="text-align:right">Actions</th></tr>
  <% testimonials.forEach(t => { %>
    <tr>
      <td><strong><%= t.name %></strong><% if (t.company) { %><br><small class="muted"><%= t.company %></small><% } %></td>
      <td class="stars-sm"><%= '★'.repeat(t.rating) %><span class="muted"><%= '☆'.repeat(5 - t.rating) %></span></td>
      <td class="muted"><%= t.text.slice(0, 80) %><%= t.text.length > 80 ? '…' : '' %></td>
      <td>
        <div class="actions">
          <a class="btn small ghost" href="<%= adminBase %>/testimonials?edit=<%= t._id %>">✏️ Edit</a>
          <form method="POST" action="<%= adminBase %>/testimonials/<%= t._id %>/delete" class="inline" onsubmit="return confirm('Delete this testimonial?')"><input type="hidden" name="_csrf" value="<%= csrf %>">
            <button type="submit" class="btn small danger">🗑 Delete</button>
          </form>
        </div>
      </td>
    </tr>
  <% }) %>
</table>

<%- include('../partials/admin_foot') %>
