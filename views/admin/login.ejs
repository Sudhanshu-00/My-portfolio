<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .captcha-row { display:flex; gap:0.6rem; align-items:center; }
    .captcha-row img { border-radius:8px; border:1px solid rgba(255,255,255,0.15); background:#0d1117; height:46px; cursor:pointer; }
    .captcha-row input { flex:1; min-width:0; }
    .hint { font-size:0.72rem; color:rgba(255,255,255,0.45); margin-top:0.25rem; }
    .pw-row { display:flex; gap:0.5rem; align-items:center; }
    .pw-toggle { background:none; border:1px solid rgba(255,255,255,0.15); border-radius:6px; color:inherit; font-size:0.72rem; padding:0.35rem 0.6rem; cursor:pointer; white-space:nowrap; }
    .pw-toggle:hover { border-color:rgba(126,231,135,0.5); }
  </style>
</head>
<body class="login-page">
  <div class="login-box">
    <h1>&gt;_ LOGIN</h1>
    <% if (query.reset) { %><div class="alert success">✅ Password has been reset — log in with your new password.</div><% } %>
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <form method="POST" action="/login" class="form">
      <label>Username
        <input type="text" name="username" required autofocus autocomplete="off">
      </label>
      <label>Password
        <span class="pw-row">
          <input type="password" name="password" id="loginPass" required>
          <button type="button" class="pw-toggle" data-reveal="loginPass" aria-pressed="false">👁 show</button>
        </span>
      </label>
      <label>Security captcha
        <span class="captcha-row">
          <img src="/login/captcha.svg" id="captchaImg" data-refresh alt="captcha" title="Click for a new captcha">
          <input type="text" name="captcha" required maxlength="10" placeholder="type the text" autocomplete="off">
        </span>
        <span class="hint">Type the 5 characters shown above (click the image for a new captcha)</span>
      </label>
      <button type="submit" class="btn full">Login</button>
    </form>
    <div class="row-between" style="margin-top:0.8rem">
      <a href="/signup" class="link" style="font-size:0.82rem">New here? → Create account</a>
      <a href="/forgot" class="link" style="font-size:0.82rem">Forgot password?</a>
    </div>
    <div class="row-between" style="margin-top:0.4rem">
      <span></span>
      <a href="/" class="link" style="font-size:0.82rem">← Website</a>
    </div>

  </div>
  <script src="/js/showpass.js"></script>
</body>
</html>
