<%- include('../partials/admin_head') %>

<div class="row-between">
  <h1>Projects</h1>
  <a class="btn" href="<%= adminBase %>/projects/new">＋ Add Project</a>
</div>

<table class="table">
  <tr><th>Photo</th><th>Title</th><th>Featured</th><th>Actions</th></tr>
  <% if (!projects.length) { %><tr><td colspan="4" class="muted">No projects yet. Click "Add Project".</td></tr><% } %>
  <% projects.forEach(p => { %>
    <tr>
      <td>
        <% if (p.image) { %><img src="<%= p.image %>" class="thumb" alt=""><% } %>
      </td>
      <td><strong><%= p.title %></strong></td>
      <td><%= p.featured ? '⭐ Yes' : '—' %></td>
      <td class="actions">
        <a class="btn small outline" href="<%= adminBase %>/projects/<%= p._id %>/edit">Edit</a>
        <form method="POST" action="<%= adminBase %>/projects/<%= p._id %>/delete" class="inline">
          <button type="submit" class="btn small danger">Delete</button>
        </form>
      </td>
    </tr>
  <% }) %>
</table>

<%- include('../partials/admin_foot') %>
