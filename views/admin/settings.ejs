<%- include('../partials/admin_head') %>

<h1>Site Settings</h1>
<p class="muted">Change all website content from here.</p>

<% if (query.saved) { %><div class="alert success">✅ Settings saved!</div><% } %>
<% if (query.resume) { %><div class="alert success">📄 Resume uploaded! The "DOWNLOAD_CV" button is now active on the public site.</div><% } %>
<% if (query.resume_deleted) { %><div class="alert success">🗑 Resume deleted.</div><% } %>
<% if (query.resume_error) { %><div class="alert error">❌ Upload failed — only PDF files (max 5 MB) are accepted.</div><% } %>

<form method="POST" action="<%= adminBase %>/settings" enctype="multipart/form-data" class="form"><input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>General</h2>
  <label>Website Name
    <input type="text" name="siteName" value="<%= settings.siteName %>" maxlength="100" required>
  </label>

  <h2>Home Page (Hero)</h2>
  <label>Main Title
    <input type="text" name="heroTitle" value="<%= settings.heroTitle %>" maxlength="150">
  </label>
  <label>Subtitle
    <input type="text" name="heroSubtitle" value="<%= settings.heroSubtitle %>" maxlength="300">
  </label>
  <label>Profile Photo
    <input type="file" name="photo" accept="image/*">
  </label>
  <% if (settings.profilePhoto) { %>
    <img src="<%= settings.profilePhoto %>" alt="Current photo" class="thumb big">
    <small class="muted">(Uploading a new photo will replace this one)</small>
  <% } %>

  <h2>About</h2>
  <label>About Text
    <textarea name="aboutText" rows="6" maxlength="5000"><%= settings.aboutText %></textarea>
  </label>

  <h2 id="resume">📄 Resume / CV</h2>
  <p class="muted">Upload a PDF — the <strong>[ ⬇ DOWNLOAD_CV ]</strong> button automatically appears in the Home page hero (<code>/resume</code>).</p>
  <% if (settings.resumeFile) { %>
    <div class="resume-row">
      <span>📎 <a class="link" href="/resume" target="_blank"><%= settings.resumeName %></a> <small class="muted">(current, ~<%= Math.round((settings.resumeFile.length * 0.75) / 1024) %> KB)</small></span>
      <form method="POST" action="<%= adminBase %>/resume/delete" class="inline" data-confirm="Delete resume?"><input type="hidden" name="_csrf" value="<%= csrf %>">
        <button type="submit" class="btn small danger">🗑 Delete</button>
      </form>
    </div>
  <% } else { %>
    <p class="muted">⚠️ No resume uploaded yet.</p>
  <% } %>
  <form method="POST" action="<%= adminBase %>/resume" enctype="multipart/form-data" class="form"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="row-form">
      <label>Upload PDF (max 5 MB)
        <input type="file" name="resume" accept="application/pdf" required>
      </label>
      <button type="submit" class="btn">⬆ Upload Resume</button>
    </div>
  </form>

  <h2>Contact Info</h2>
  <label>Email
    <input type="text" name="email" value="<%= settings.email %>" maxlength="100">
  </label>
  <label>Phone
    <input type="text" name="phone" value="<%= settings.phone %>" maxlength="20">
  </label>
  <label>Location
    <input type="text" name="location" value="<%= settings.location %>" maxlength="120">
  </label>

  <h2>Social Links</h2>
  <label>GitHub Username (for live repo data, e.g. Sudhanshu-00)
    <input type="text" name="githubUsername" value="<%= settings.githubUsername || '' %>" maxlength="60">
  </label>
  <label>TryHackMe Username (for the badge on the labs page, e.g. sudhanshu)
    <input type="text" name="thmUsername" value="<%= settings.thmUsername || '' %>" maxlength="60">
  </label>
  <label>GitHub URL
    <input type="text" name="github" value="<%= settings.github %>" maxlength="500" placeholder="https://github.com/username">
  </label>
  <label>LinkedIn URL
    <input type="text" name="linkedin" value="<%= settings.linkedin %>" maxlength="500" placeholder="https://linkedin.com/in/username">
  </label>
  <label>Twitter / X URL
    <input type="text" name="twitter" value="<%= settings.twitter %>" maxlength="500">
  </label>
  <label>Instagram URL
    <input type="text" name="instagram" value="<%= settings.instagram %>" maxlength="500">
  </label>
  <label>WhatsApp Number (for tool sales — without +, e.g. 919876543210)
    <input type="text" name="whatsapp" value="<%= settings.whatsapp || '' %>" maxlength="20">
  </label>
  <label>Telegram Username (e.g. sudhanshu_h4x)
    <input type="text" name="telegram" value="<%= settings.telegram || '' %>" maxlength="60">
  </label>

  <h2>➕ More Social Links (custom)</h2>
  <p class="muted">Any public URL beyond LinkedIn/GitHub/Twitter (Discord, YouTube, Portfolio, TryHackMe...) — add it here. These render on the About and Contact pages.</p>
  <div id="custom-links">
    <% (settings.customLinks || []).forEach(l => { %>
      <div class="cl-row">
        <input type="text" name="custom_label" maxlength="40" placeholder="Label (e.g. YouTube)" value="<%= l.label %>">
        <input type="text" name="custom_url" maxlength="500" placeholder="https://..." value="<%= l.url %>">
        <button type="button" class="btn small danger cl-del">✕</button>
      </div>
    <% }) %>
  </div>
  <button type="button" class="btn small ghost" id="cl-add">＋ Add More Link</button>

  <button type="submit" class="btn">💾 Save Settings</button>
</form>

<script src="/js/admin.js?v=<%= assetV %>"></script>

<%- include('../partials/admin_foot') %>
