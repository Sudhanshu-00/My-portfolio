<%- include('../partials/admin_head') %>

<h1>Site Settings</h1>
<p class="muted">Yahan se puri website ka content change kar sakte ho.</p>

<% if (query.saved) { %><div class="alert success">✅ Settings saved!</div><% } %>
<% if (query.resume) { %><div class="alert success">📄 Resume uploaded! Public site pe "DOWNLOAD_CV" button active ho gaya.</div><% } %>
<% if (query.resume_deleted) { %><div class="alert success">🗑 Resume deleted.</div><% } %>
<% if (query.resume_error) { %><div class="alert error">❌ Upload failed — sirf PDF (max 5 MB) upload karo.</div><% } %>

<form method="POST" action="<%= adminBase %>/settings" enctype="multipart/form-data" class="form">
  <h2>General</h2>
  <label>Website Name
    <input type="text" name="siteName" value="<%= settings.siteName %>" required>
  </label>

  <h2>Home Page (Hero)</h2>
  <label>Main Title
    <input type="text" name="heroTitle" value="<%= settings.heroTitle %>">
  </label>
  <label>Subtitle
    <input type="text" name="heroSubtitle" value="<%= settings.heroSubtitle %>">
  </label>
  <label>Profile Photo
    <input type="file" name="photo" accept="image/*">
  </label>
  <% if (settings.profilePhoto) { %>
    <img src="<%= settings.profilePhoto %>" alt="Current photo" class="thumb big">
    <small class="muted">(New photo upload karne par change hogi)</small>
  <% } %>

  <h2>About</h2>
  <label>About Text
    <textarea name="aboutText" rows="6"><%= settings.aboutText %></textarea>
  </label>

  <h2 id="resume">📄 Resume / CV</h2>
  <p class="muted">PDF upload karo — Home page hero me <strong>[ ⬇ DOWNLOAD_CV ]</strong> button automatically show hoga (<code>/resume</code>).</p>
  <% if (settings.resumeFile) { %>
    <div class="resume-row">
      <span>📎 <a class="link" href="/resume" target="_blank"><%= settings.resumeName %></a> <small class="muted">(current, ~<%= Math.round((settings.resumeFile.length * 0.75) / 1024) %> KB)</small></span>
      <form method="POST" action="<%= adminBase %>/resume/delete" class="inline" onsubmit="return confirm('Delete resume?')">
        <button type="submit" class="btn small danger">🗑 Delete</button>
      </form>
    </div>
  <% } else { %>
    <p class="muted">⚠️ No resume uploaded yet.</p>
  <% } %>
  <form method="POST" action="<%= adminBase %>/resume" enctype="multipart/form-data" class="form">
    <div class="row-form">
      <label>Upload PDF (max 5 MB)
        <input type="file" name="resume" accept="application/pdf" required>
      </label>
      <button type="submit" class="btn">⬆ Upload Resume</button>
    </div>
  </form>

  <h2>Contact Info</h2>
  <label>Email
    <input type="text" name="email" value="<%= settings.email %>">
  </label>
  <label>Phone
    <input type="text" name="phone" value="<%= settings.phone %>">
  </label>
  <label>Location
    <input type="text" name="location" value="<%= settings.location %>">
  </label>

  <h2>Social Links</h2>
  <label>GitHub Username (live repo data ke liye, e.g. Sudhanshu-00)
    <input type="text" name="githubUsername" value="<%= settings.githubUsername || '' %>">
  </label>
  <label>TryHackMe Username (labs page pe badge ke liye, e.g. sudhanshu)
    <input type="text" name="thmUsername" value="<%= settings.thmUsername || '' %>">
  </label>
  <label>GitHub URL
    <input type="text" name="github" value="<%= settings.github %>" placeholder="https://github.com/username">
  </label>
  <label>LinkedIn URL
    <input type="text" name="linkedin" value="<%= settings.linkedin %>" placeholder="https://linkedin.com/in/username">
  </label>
  <label>Twitter / X URL
    <input type="text" name="twitter" value="<%= settings.twitter %>">
  </label>
  <label>Instagram URL
    <input type="text" name="instagram" value="<%= settings.instagram %>">
  </label>
  <label>WhatsApp Number (tool sales ke liye — without +, e.g. 919876543210)
    <input type="text" name="whatsapp" value="<%= settings.whatsapp || '' %>">
  </label>
  <label>Telegram Username (e.g. sudhanshu_h4x)
    <input type="text" name="telegram" value="<%= settings.telegram || '' %>">
  </label>

  <h2>➕ More Social Links (custom)</h2>
  <p class="muted">LinkedIn/GitHub/Twitter ke alawa jo bhi public URL dena ho (Discord, YouTube, Portfolio, TryHackMe...) — yahan add karo. Ye About aur Contact page pe render honge.</p>
  <div id="custom-links">
    <% (settings.customLinks || []).forEach(l => { %>
      <div class="cl-row">
        <input type="text" name="custom_label[]" placeholder="Label (e.g. YouTube)" value="<%= l.label %>">
        <input type="text" name="custom_url[]" placeholder="https://..." value="<%= l.url %>">
        <button type="button" class="btn small danger cl-del">✕</button>
      </div>
    <% }) %>
  </div>
  <button type="button" class="btn small ghost" id="cl-add">＋ Add More Link</button>

  <button type="submit" class="btn">💾 Save Settings</button>
</form>

<script>
  (function () {
    const list = document.getElementById('custom-links');
    document.getElementById('cl-add').addEventListener('click', () => {
      const row = document.createElement('div');
      row.className = 'cl-row';
      row.innerHTML =
        '<input type="text" name="custom_label[]" placeholder="Label (e.g. YouTube)">' +
        '<input type="text" name="custom_url[]" placeholder="https://...">' +
        '<button type="button" class="btn small danger cl-del">✕</button>';
      list.appendChild(row);
    });
    list.addEventListener('click', (e) => {
      if (e.target.classList.contains('cl-del')) e.target.parentElement.remove();
    });
  })();
</script>

<%- include('../partials/admin_foot') %>
