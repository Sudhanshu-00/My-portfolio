<%- include('../partials/admin_head') %>

<h1>Skills</h1>

<div class="panel">
  <h2><%= editSkill ? '✏️ Edit Skill: ' + editSkill.name : '＋ Add Skill' %></h2>
  <form method="POST" action="<%= editSkill ? '/admin/skills/' + editSkill._id + '/update' : '/admin/skills' %>" class="form row-form">
    <label>Name
      <input type="text" name="name" required placeholder="e.g. React" value="<%= editSkill ? editSkill.name : '' %>">
    </label>
    <label>Level (0-100)
      <input type="number" name="level" min="0" max="100" value="<%= editSkill ? editSkill.level : 80 %>">
    </label>
    <label>Category
      <input type="text" name="category" placeholder="e.g. Frontend" value="<%= editSkill ? editSkill.category : '' %>">
    </label>
    <button type="submit" class="btn"><%= editSkill ? '💾 Update' : 'Add' %></button>
    <% if (editSkill) { %><a class="btn ghost" href="<%= adminBase %>/skills">Cancel</a><% } %>
  </form>
</div>

<table class="table">
  <tr><th>Skill</th><th>Level</th><th>Category</th><th></th></tr>
  <% if (!skills.length) { %><tr><td colspan="4" class="muted">No skills yet.</td></tr><% } %>
  <% skills.forEach(s => { %>
    <tr>
      <td><strong><%= s.name %></strong></td>
      <td style="min-width:140px">
        <div class="bar"><div class="bar-fill" style="width:<%= s.level %>%"></div></div>
        <small class="muted"><%= s.level %>%</small>
      </td>
      <td><%= s.category %></td>
      <td>
        <div class="actions">
          <a class="btn small ghost" href="<%= adminBase %>/skills?edit=<%= s._id %>">✏️ Edit</a>
          <form method="POST" action="<%= adminBase %>/skills/<%= s._id %>/delete" class="inline">
            <button type="submit" class="btn small danger">Delete</button>
          </form>
        </div>
      </td>
    </tr>
  <% }) %>
</table>

<%- include('../partials/admin_foot') %>
