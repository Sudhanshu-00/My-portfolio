<%- include('../partials/admin_head') %>

<h1>💼 Services (Hire Me)</h1>
<p class="muted">Jo services bechta ho (pentest packages etc.) — ye Home page ke <strong>HIRE_ME</strong> section me price ke saath dikhengi.</p>

<div class="panel">
  <h2><%= editService ? '✏️ Edit Service: ' + editService.title : '➕ Add New Service' %></h2>
  <form method="POST" action="<%= editService ? '/admin/services/' + editService._id + '/update' : '/admin/services' %>" class="form"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="row-form">
      <label>Service Title
        <input type="text" name="title" placeholder="e.g. Web App Penetration Test" required value="<%= editService ? editService.title : '' %>">
      </label>
      <label>Price
        <input type="text" name="price" placeholder="e.g. ₹4,999 or Custom" value="<%= editService ? editService.price : '' %>">
      </label>
    </div>
    <label>Description
      <textarea name="description" rows="3" placeholder="Kya milega is service me?"><%= editService ? editService.description : '' %></textarea>
    </label>
    <button type="submit" class="btn"><%= editService ? '💾 Update Service' : '➕ Add Service' %></button>
    <% if (editService) { %><a class="btn ghost" href="<%= adminBase %>/services">Cancel</a><% } %>
  </form>
</div>

<h2>Current Services (<%= services.length %>)</h2>
<% if (!services.length) { %><p class="muted">No services yet — upar se add karo.</p><% } %>
<table class="table">
  <tr><th>Title</th><th>Price</th><th>Description</th><th style="text-align:right">Actions</th></tr>
  <% services.forEach(s => { %>
    <tr>
      <td><strong><%= s.title %></strong></td>
      <td class="mono"><%= s.price || '—' %></td>
      <td class="muted"><%= (s.description || '').slice(0, 80) %><%= (s.description || '').length > 80 ? '…' : '' %></td>
      <td>
        <div class="actions">
          <a class="btn small ghost" href="<%= adminBase %>/services?edit=<%= s._id %>">✏️ Edit</a>
          <form method="POST" action="<%= adminBase %>/services/<%= s._id %>/delete" class="inline" onsubmit="return confirm('Delete this service?')"><input type="hidden" name="_csrf" value="<%= csrf %>">
            <button type="submit" class="btn small danger">🗑 Delete</button>
          </form>
        </div>
      </td>
    </tr>
  <% }) %>
</table>

<%- include('../partials/admin_foot') %>
