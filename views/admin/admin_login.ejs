<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Access</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-page">
  <div class="login-box">
    <h1>&gt;_ ADMIN ACCESS</h1>
    <p class="muted">Restricted area — admin only 🔒</p>
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <form method="POST" action="/login" class="form">
      <label>Username
        <input type="text" name="username" required autofocus autocomplete="off">
      </label>
      <label>Password
        <input type="password" name="password" required>
      </label>
      <button type="submit" class="btn full">Login to Admin Panel</button>
    </form>
    <a href="/login" class="link" style="font-size:0.82rem">← Back to login</a>
  </div>
</body>
</html>
