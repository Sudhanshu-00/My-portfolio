<%- include('../partials/admin_head') %>

<h1>🔑 Change Password</h1>

<% if (success) { %><div class="alert success">✅ Password changed successfully!</div><% } %>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>

<form method="POST" action="/admin/password" class="form narrow">
  <label>Current Password
    <input type="password" name="current_pass" required>
  </label>
  <label>New Password (min 6 characters)
    <input type="password" name="new_pass" required minlength="6">
  </label>
  <label>Confirm New Password
    <input type="password" name="confirm_pass" required minlength="6">
  </label>
  <button type="submit" class="btn">Update Password</button>
</form>

<%- include('../partials/footer') %>
