<%- include('../partials/admin_head') %>

<h1>🔑 Change Password</h1>
<p class="muted">Strong password policy active: <strong>min 8 characters</strong> with at least one <strong>UPPERCASE</strong> letter, one <strong>lowercase</strong> letter, one <strong>number</strong> and one <strong>symbol</strong> (e.g. <code>Aa1!xyz9</code>).</p>

<% if (success) { %><div class="alert success">✅ Password changed successfully!</div><% } %>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>

<form method="POST" action="<%= adminBase %>/password" class="form narrow"><input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Current Password
    <input type="password" name="current_pass" id="curPass" required>
  </label>
  <label>New Password (min 8 — A-Z, a-z, 0-9, symbol)
    <input type="password" name="new_pass" id="newPass" required minlength="8" autocomplete="new-password">
  </label>
  <label>Confirm New Password
    <input type="password" name="confirm_pass" id="confPass" required minlength="8" autocomplete="new-password">
  </label>
  <div class="actions" style="gap:0.5rem;margin-top:0.4rem">
    <button type="button" class="btn small outline" data-reveal="curPass">👁 show current</button>
    <button type="button" class="btn small outline" data-reveal="newPass">👁 show new</button>
    <button type="button" class="btn small outline" data-reveal="confPass">👁 show confirm</button>
    <button type="submit" class="btn">Update Password</button>
  </div>
</form>

<%- include('../partials/admin_foot') %>
