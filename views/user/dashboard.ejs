<%- include('../partials/header', { title: 'Dashboard' }) %>

<!-- ===== Dashboard header ===== -->
<div class="ud-head">
  <div>
    <h1>&gt;_ USER DASHBOARD</h1>
    <p class="ud-who">[ 👤 <%= username %> ] <span class="muted">— welcome back, commander</span></p>
  </div>
  <div style="text-align:right">
    <span class="badge <%= profile.role === 'admin' ? 'warn' : 'dim' %>">ROLE: <%= (profile.role || 'user').toUpperCase() %></span>
    <span class="badge" style="font-size:0.68rem">SESSION: ENCRYPTED</span>
  </div>
</div>

<% if (saved) { %><div class="alert success">✅ Saved<%= pwError ? '' : ' — profile updated.' %></div><% } %>
<% if (pwError) { %><div class="alert error"><%= pwError %></div><% } %>

<!-- ===== Stats (read-only) ===== -->
<div class="ud-stats">
  <div class="ud-stat"><b><%= stats.projects %></b><span>PROJECTS</span></div>
  <div class="ud-stat"><b><%= stats.tools %></b><span>TOOLS</span></div>
  <div class="ud-stat"><b><%= stats.labs %></b><span>LABS</span></div>
  <div class="ud-stat"><b><%= stats.experience %></b><span>EXPERIENCE</span></div>
  <div class="ud-stat"><b><%= stats.testimonials %></b><span>TESTIMONIALS</span></div>
  <div class="ud-stat"><b><%= stats.services %></b><span>SERVICES</span></div>
</div>

<div class="ud-grid">
  <!-- ===== Left: projects (READ-ONLY) ===== -->
  <div class="ud-panel">
    <h2>📁 PROJECTS <span class="badge warn" style="font-size:0.62rem">READ-ONLY</span></h2>
    <p class="muted" style="font-size:0.8rem;margin-bottom:0.4rem">View only — editing is disabled for user accounts.</p>
    <% if (!projects.length) { %>
      <p class="muted" style="font-size:0.88rem">No projects published yet.</p>
    <% } else { %>
      <% projects.forEach((p) => { %>
        <div class="ud-proj">
          <div class="row-between">
            <strong><%= p.title %></strong>
            <% if (p.featured) { %><span class="badge" style="font-size:0.6rem">★ FEATURED</span><% } %>
          </div>
          <% if (p.description) { %>
            <p style="font-size:0.85rem;margin:0.35rem 0 0.15rem"><%= String(p.description).slice(0, 200) %><%= String(p.description).length > 200 ? '…' : '' %></p>
          <% } %>
          <% if (p.techStack) { %>
            <div class="ud-chips">
              <% String(p.techStack).split(',').map((t) => t.trim()).filter(Boolean).forEach((t) => { %>
                <span class="ud-chip"><%= t %></span>
              <% }) %>
            </div>
          <% } %>
          <div style="margin-top:0.5rem">
            <% if (p.liveUrl) { %><a href="<%= p.liveUrl %>" target="_blank" rel="noopener noreferrer nofollow" class="link" style="font-size:0.78rem">[ live ↗ ]</a><% } %>
            <% if (p.githubUrl) { %><a href="<%= p.githubUrl %>" target="_blank" rel="noopener noreferrer nofollow" class="link" style="font-size:0.78rem;margin-left:0.5rem">[ github ↗ ]</a><% } %>
            <a href="/projects" class="link" style="font-size:0.78rem;margin-left:0.5rem">[ public page ]</a>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>

  <!-- ===== Right column ===== -->
  <div>
    <!-- account info (SIRF APNI details — doosre user ka data yahan kabhi nahi aata) -->
    <div class="ud-panel">
      <h2>👤 MY DETAILS</h2>
      <div class="ud-kv"><span>username</span><span class="mono"><%= username %></span></div>
      <div class="ud-kv"><span>role</span><span class="mono ok"><%= (profile.role || 'user').toUpperCase() %></span></div>
      <div class="ud-kv"><span>joined</span><span class="mono"><%= profile.createdAt ? new Date(profile.createdAt).toLocaleDateString('en-IN', { dateStyle: 'medium' }) : '—' %></span></div>
      <div class="ud-kv"><span>last login</span><span class="mono"><%= profile.lastLoginAt ? new Date(profile.lastLoginAt).toLocaleString('en-IN', { dateStyle: 'short', timeStyle: 'short' }) : '—' %></span></div>
      <div class="ud-kv"><span>privacy</span><span class="mono ok">PRIVATE — only you + admin</span></div>
      <form method="POST" action="/user/<%= username %>/profile" class="form" style="margin-top:0.7rem">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label>Name <input name="name" maxlength="60" value="<%= profile.name || '' %>"></label>
        <label>Email <input type="email" name="email" maxlength="100" value="<%= profile.email || '' %>"></label>
        <label>Phone <input name="phone" maxlength="20" value="<%= profile.phone || '' %>"></label>
        <label>Bio <input name="bio" maxlength="300" value="<%= profile.bio || '' %>"></label>
        <button type="submit" class="btn full small">Save my details</button>
      </form>
    </div>

    <!-- change own password -->
    <div class="ud-panel">
      <h2>🔑 CHANGE MY PASSWORD</h2>
      <form method="POST" action="/user/<%= username %>/password" class="form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label>Current password
          <input type="password" name="current" required autocomplete="current-password">
        </label>
        <label>New password (min 8 chars)
          <input type="password" name="next" required minlength="8" autocomplete="new-password">
        </label>
        <label>Confirm new password
          <input type="password" name="confirm" required minlength="8" autocomplete="new-password">
        </label>
        <button type="submit" class="btn full">Update password</button>
      </form>
    </div>

    <!-- tools (read-only) -->
    <div class="ud-panel">
      <h2>🧰 TOOLS <span class="badge warn" style="font-size:0.62rem">READ-ONLY</span></h2>
      <% if (!tools.length) { %>
        <p class="muted" style="font-size:0.85rem">No tools yet.</p>
      <% } else { %>
        <div class="ud-chips">
          <% tools.forEach((t) => { %><span class="ud-chip"><%= t.name %></span><% }) %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- ===== Footer actions ===== -->
<div class="ud-foot">
  <a href="/" class="btn ghost small" style="margin-right:0.6rem">← Website</a>
  <form method="POST" action="/logout" class="inline" style="display:inline">
    <button type="submit" class="btn ghost small">Logout</button>
  </form>
  <% if (adminGate) { %>
    <!-- Admin option — ONLY for the user named 'sudhanshu' -->
    <div class="side-sep" style="margin:1.2rem auto;max-width:70%"></div>
    <p><a href="/user/<%= username %>/admin/login" class="link" style="font-size:0.9rem;opacity:0.75">⚡ Admin</a></p>
  <% } %>
</div>

<%- include('../partials/footer') %>
