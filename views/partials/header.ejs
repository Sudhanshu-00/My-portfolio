<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' && title ? title + ' | ' : '' %><%= settings.siteName %></title>

  <!-- SEO -->
  <meta name="description" content="<%= settings.heroSubtitle %>">
  <meta name="author" content="<%= settings.siteName %>">
  <meta name="keywords" content="pentesting, cybersecurity, web security, android security, ethical hacking, <%= settings.siteName %>">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='18' fill='%23052012'/><text x='50' y='68' font-size='55' text-anchor='middle' fill='%2300ff41' font-family='monospace' font-weight='bold'>&gt;_</text></svg>">

  <!-- Open Graph (WhatsApp / Facebook / Discord preview) -->
  <meta property="og:title" content="<%= typeof title !== 'undefined' && title ? title + ' | ' : '' %><%= settings.siteName %>">
  <meta property="og:description" content="<%= settings.heroSubtitle %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= settings.siteName %>">
  <% if (settings.profilePhoto) { %><meta property="og:image" content="<%= settings.profilePhoto %>"><% } %>

  <!-- Twitter / X card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' && title ? title + ' | ' : '' %><%= settings.siteName %>">
  <meta name="twitter:description" content="<%= settings.heroSubtitle %>">

  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div id="boot" class="boot"><pre id="boot-text"></pre></div>
<div class="scanlines"></div>
<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand">root@<%= String(settings.siteName || 'h4x0r').toLowerCase().replace(/[^a-z0-9]/g, '') %><span class="p">:~$</span><span class="cursor">▊</span></a>
    <button class="nav-toggle" id="navToggle" type="button" aria-label="Menu kholo/band karo" aria-expanded="false" aria-controls="navLinks">
      <span></span><span></span><span></span>
    </button>
    <div class="nav-links" id="navLinks">
      <%
        // Admin → Appearance se editable navbar — har page par same (global partial).
        // url khali = plain text (clickable nahi); newTab = naye tab me khulega.
        const navItems = ((settings.navItems && settings.navItems.length ? settings.navItems : []) || [])
          .filter((n) => n && n.label && n.visible !== false)
          .sort((a, b) => (a.order || 0) - (b.order || 0));
        const navPageList = (typeof navPages !== 'undefined' ? navPages : []) || [];
      %>
      <% navItems.forEach((n) => { %>
        <% if (n.url) { %>
          <a href="<%= n.url %>"<% if (n.newTab) { %> target="_blank" rel="noopener noreferrer"<% } %>><%= n.label %></a>
        <% } else { %>
          <span class="mono" style="opacity:0.45"><%= n.label %></span>
        <% } %>
      <% }) %>
      <% navPageList.forEach((pg) => { %>
        <a href="/p/<%= pg.slug %>"<% if (pg.navNewTab) { %> target="_blank" rel="noopener noreferrer"<% } %>><%= pg.navLabel || pg.title %></a>
      <% }) %>
      <% const who = (typeof sessionUser !== 'undefined' && sessionUser) || (typeof sessionAdmin !== 'undefined' && sessionAdmin); %>
      <% if (who) { %>
        <a href="/user/<%= encodeURIComponent(who) %>">./dashboard</a>
        <span class="mono" style="color:var(--green,#00ff41);font-size:0.85rem">[ 👤 <%= who %> ]</span>
        <form method="POST" action="/logout" class="inline" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= typeof csrf !== 'undefined' ? csrf : '' %>">
          <button type="submit" class="link" style="background:none;border:none;cursor:pointer;font-size:0.85rem;color:var(--text,#e6edf3);opacity:1">[ logout ]</button>
        </form>
      <% } else { %>
        <a href="/login">./login</a>
        <a href="/signup">./signup</a>
      <% } %>
    </div>
  </div>
</nav>
<main class="container">
