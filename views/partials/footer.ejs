</main>
<footer class="footer">
  <div class="container footer-inner">
    <p class="mono">[ SYSTEM: <span class="ok">SECURE</span> ] · [ UPLINK: <span class="ok">ENCRYPTED</span> ] · [ © <%= new Date().getFullYear() %> <%= settings.siteName %> ]</p>
    <% if (typeof visits !== 'undefined' && visits) { %>
      <p class="visitor-counter" title="Live visitor counter">
        <span class="pulse-dot">●</span> [ VISITORS: <span class="ok"><%= visits.total.toLocaleString('en-IN') %></span> ] · [ TODAY: <span class="ok"><%= visits.today %></span> ]
      </p>
    <% } %>
    <p class="muted" style="font-size:0.75rem">© <%= new Date().getFullYear() %> — <%= settings.footerText %></p>
    <% if (settings.footerNote) { %><p class="muted" style="font-size:0.72rem"><%= settings.footerNote %></p><% } %>
    <%
      // Admin → Appearance se editable footer links (url khali = plain text, clickable nahi)
      const flinks = (settings.footerLinks || []).filter((l) => l && l.label);
    %>
    <% if (flinks.length) { %>
      <p style="margin-top:0.4rem;font-size:0.8rem">
        <% flinks.forEach((l, i) => { %><% if (i) { %> · <% } %><% if (l.url) { %><a href="<%= l.url %>" class="link"<% if (l.newTab) { %> target="_blank" rel="noopener noreferrer"<% } %>><%= l.label %></a><% } else { %><span class="muted"><%= l.label %></span><% } %><% }) %>
      </p>
    <% } %>
    <p style="margin-top:0.3rem"><a href="/login" class="link" style="font-size:0.72rem;opacity:0.45">login</a></p>
  </div>
</footer>
<script src="/js/hacker.js"></script>
<script src="/js/guard.js"></script>
<% if (typeof loadBlogJs !== 'undefined' && loadBlogJs) { %><script src="/js/blog.js" defer></script><% } %>
</body>
</html>
