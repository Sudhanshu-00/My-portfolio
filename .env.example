# ===== My Portfolio — Environment Template =====
# Naye device pe: cp .env.example .env  → phir REAL values bharo
# ⚠️ REAL values kabhi git me push mat karna — .env gitignored hai

# MongoDB Atlas (cloud) — URI cloud.mongodb.com → Database → Connect → Drivers se milega
MONGODB_URI=

# Session security — long random string: openssl rand -hex 32
SESSION_SECRET=

# Admin login (first-run seed)
ADMIN_USER=admin
ADMIN_PASS=

# Secret admin panel path — random: openssl rand -hex 10 (20 hex chars)
# Panel: /<ADMIN_PATH>  |  /admin hamesha 404
ADMIN_PATH=

# Admin email — forgot-password OTP isi pe jayega
ADMIN_EMAIL=

# Gmail SMTP — App Password (2FA ON karke myaccount.google.com → App passwords, 16 chars)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
