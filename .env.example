# ===== My Portfolio — Environment Template =====
# On a new device: cp .env.example .env → then fill in REAL values
# ⚠️ Never push REAL values to git — .env is gitignored

# MongoDB Atlas (cloud) — get the URI from cloud.mongodb.com → Database → Connect → Drivers
MONGODB_URI=

# Session security — long random string: openssl rand -hex 32
SESSION_SECRET=

# Admin login (first-run seed)
ADMIN_USER=admin
ADMIN_PASS=

# Secret admin panel path — random: openssl rand -hex 10 (20 hex chars)
# Panel: /<ADMIN_PATH>  |  /admin always returns 404
ADMIN_PATH=

# Admin email — the forgot-password OTP is sent here
ADMIN_EMAIL=

# Public URL of the deployed site (uptime monitor + keep-alive pings target)
# e.g. https://my-portfolio-fp1g.onrender.com
PROD_URL=

# Where downtime / attack alert emails go (blank = ADMIN_EMAIL)
ALERT_EMAIL=

# Keep-alive: self-ping every 10 min so Render free plan never spins down
# (spin-down = next visitor waits 30-60s). Set false to allow sleeping.
KEEP_ALIVE=true

# RSS memory (MB) above which a "down hone wala hai" warning email is sent
MEM_ALERT_MB=450

# Gmail SMTP — App Password (enable 2FA, then myaccount.google.com → App passwords, 16 chars)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
